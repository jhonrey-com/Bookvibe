Windows Registry Editor Version 5.00

; Quillvibe Official Per-User File Extension Registrations
; Replace C:\\Program Files\\Quillvibe\\quillvibe.exe with your Quillvibe executable path if installing manually.
; Quillvibe also writes these keys automatically under HKEY_CURRENT_USER on launch (no Administrator required).

[HKEY_CURRENT_USER\Software\Classes\.qv]
@="Quillvibe.Workspace.2"
"Content Type"="application/vnd.quillvibe.workspace"
"PerceivedType"="document"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Workspace.2]
@="Quillvibe Book Workspace"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Workspace.2\DefaultIcon]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Workspace.2\shell\open\command]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.qvbible]
@="Quillvibe.Bible.2"
"Content Type"="application/vnd.quillvibe.bible"
"PerceivedType"="document"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Bible.2]
@="Quillvibe Story Bible Database"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Bible.2\DefaultIcon]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Bible.2\shell\open\command]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.qvscene]
@="Quillvibe.Scene.2"
"Content Type"="application/vnd.quillvibe.scene"
"PerceivedType"="document"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Scene.2]
@="Quillvibe Standalone Scene Draft"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Scene.2\DefaultIcon]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Scene.2\shell\open\command]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.qvstyle]
@="Quillvibe.Style.2"
"Content Type"="application/vnd.quillvibe.style"
"PerceivedType"="document"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Style.2]
@="Quillvibe Typeset Preset"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Style.2\DefaultIcon]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Quillvibe.Style.2\shell\open\command]
@="\"C:\\Program Files\\Quillvibe\\quillvibe.exe\" \"%1\""
