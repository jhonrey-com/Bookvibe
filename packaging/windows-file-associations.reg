Windows Registry Editor Version 5.00

; Bookvibe Official Per-User File Extension Registrations
; Replace C:\\Program Files\\Bookvibe\\bookvibe.exe with your Bookvibe executable path if installing manually.
; Bookvibe also writes these keys automatically under HKEY_CURRENT_USER on launch (no Administrator required).

[HKEY_CURRENT_USER\Software\Classes\.bookvibe]
@="Bookvibe.Project.1"
"Content Type"="application/vnd.bookvibe.project+json"
"PerceivedType"="document"

[HKEY_CURRENT_USER\Software\Classes\Bookvibe.Project.1]
@="Bookvibe Master Project"

[HKEY_CURRENT_USER\Software\Classes\Bookvibe.Project.1\DefaultIcon]
@="\"C:\\Program Files\\Bookvibe\\bookvibe.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Bookvibe.Project.1\shell\open\command]
@="\"C:\\Program Files\\Bookvibe\\bookvibe.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.bvibe]
@="Bookvibe.CompactProject.1"
"Content Type"="application/vnd.bookvibe.project+json"
"PerceivedType"="document"

[HKEY_CURRENT_USER\Software\Classes\Bookvibe.CompactProject.1]
@="Bookvibe Compact Project"

[HKEY_CURRENT_USER\Software\Classes\Bookvibe.CompactProject.1\DefaultIcon]
@="\"C:\\Program Files\\Bookvibe\\bookvibe.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Bookvibe.CompactProject.1\shell\open\command]
@="\"C:\\Program Files\\Bookvibe\\bookvibe.exe\" \"%1\""

