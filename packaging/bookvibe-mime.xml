<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.bookvibe.project+json">
    <comment>Bookvibe Master Project</comment>
    <sub-class-of type="application/json"/>
    <magic priority="80">
      <match type="string" offset="0:256" value='"magic": "BOOKVIBE_V1"'>
        <match type="string" offset="0:512" value='"extension": ".bookvibe"'/>
      </match>
      <match type="string" offset="0:256" value='"magic": "BOOKVIBE_V1"'>
        <match type="string" offset="0:512" value='"extension": ".bvibe"'/>
      </match>
    </magic>
    <glob pattern="*.bookvibe"/>
    <glob pattern="*.bvibe"/>
  </mime-type>

