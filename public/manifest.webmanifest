{
  "name": "Quillvibe",
  "short_name": "Quillvibe",
  "description": "Free offline book writing, proofreading, Story Bible, interior typesetting, and cover design studio.",
  "start_url": "/write",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f4ef",
  "theme_color": "#f6f4ef",
  "categories": ["productivity", "books", "education"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "/write",
      "accept": {
        "application/vnd.quillvibe.workspace": [".qv"],
        "application/vnd.quillvibe.bible": [".qvbible"],
        "application/vnd.quillvibe.scene": [".qvscene"],
        "application/vnd.quillvibe.style": [".qvstyle"],
        "application/vnd.quillvibe.design": [".qvdesign"]
      }
    }
  ]
}
